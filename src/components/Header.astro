---
import { Image } from "astro:assets";
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import logoMandala from "@/assets/theme/logo-mandala.png";

interface Props {
  shortName: string;
}
const { shortName } = Astro.props;

const navLinks = [
  { name: "About", href: "/about" },
  { name: "Experience", href: "/experience" },
  { name: "Research", href: "/research" },
  { name: "Publications", href: "/publications" },
  { name: "Education", href: "/education" },
  { name: "Creative", href: "/creative" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href;
// The Contact page sits on solid primary pink, so the unscrolled header goes white there.
const onPrimary = path === "/contact";
---

<header
  id="site-header"
  data-on-primary={onPrimary ? "" : undefined}
  class="group/header fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent py-6 data-[scrolled]:bg-white/80 data-[scrolled]:backdrop-blur-md data-[scrolled]:shadow-sm data-[scrolled]:py-4"
>
  <div class="container mx-auto px-6 flex items-center justify-between">
    <a
      href="/"
      class="logo-link font-serif text-xl font-bold text-primary tracking-wide flex items-center gap-2 group-data-[on-primary]/header:not-group-data-[scrolled]/header:text-white"
    >
      <Image src={logoMandala} alt="" width={68} height={68} class="logo-mandala inline-block w-[34px] h-[34px]" draggable="false" />
      {shortName}
    </a>

    <nav class="hidden md:flex items-center space-x-8" aria-label="Main">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "text-sm font-medium transition-colors",
              isActive(link.href) ? "text-primary border-b-2 border-primary pb-0.5" : "text-foreground hover:text-primary",
              onPrimary && "group-not-data-[scrolled]/header:text-white group-not-data-[scrolled]/header:hover:text-white/80",
            ]}
          >
            {link.name}
          </a>
        ))
      }
      <a
        href="/contact"
        aria-current={isActive("/contact") ? "page" : undefined}
        class:list={[
          "inline-flex items-center justify-center h-9 px-4 rounded-full border text-sm font-medium transition-colors",
          isActive("/contact")
            ? "bg-primary border-primary text-white group-not-data-[scrolled]/header:bg-white group-not-data-[scrolled]/header:border-white group-not-data-[scrolled]/header:text-primary"
            : "border-primary text-primary hover:bg-primary hover:text-white",
        ]}
      >
        Contact
      </a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class:list={["md:hidden text-foreground p-1 -m-1", onPrimary && "group-not-data-[scrolled]/header:text-white"]}
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <Menu size={24} class="menu-open" aria-hidden="true" />
      <X size={24} class="menu-close hidden" aria-hidden="true" />
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile"
    hidden
    class="absolute top-full left-0 w-full bg-white shadow-lg py-4 px-6 flex flex-col space-y-4 md:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={[
            "text-base font-medium transition-colors",
            isActive(link.href) ? "text-primary" : "text-foreground hover:text-primary",
          ]}
        >
          {link.name}
        </a>
      ))
    }
    <a href="/contact" class="text-base font-medium text-primary hover:underline">Contact</a>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;

  const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 20);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    toggle.querySelector(".menu-open")?.classList.toggle("hidden", open);
    toggle.querySelector(".menu-close")?.classList.toggle("hidden", !open);
  };
  const isOpen = () => !menu.hasAttribute("hidden");
  toggle.addEventListener("click", () => setOpen(!isOpen()));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) setOpen(false);
  });
</script>
