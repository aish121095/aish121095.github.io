---
import Stethoscope from "@lucide/astro/icons/stethoscope";
import House from "@lucide/astro/icons/house";
import UserRound from "@lucide/astro/icons/user-round";
import BookOpen from "@lucide/astro/icons/book-open";
import Briefcase from "@lucide/astro/icons/briefcase-medical";
import Mail from "@lucide/astro/icons/mail";
import BaseLayout from "@/layouts/BaseLayout.astro";
import MandalaMotif from "@/components/MandalaMotif.astro";
import PaisleyMotif from "@/components/PaisleyMotif.astro";
import JaliBorder from "@/components/JaliBorder.astro";
import { getSite } from "@/lib/content";

const { notFound } = await getSite();

const nextSteps = [
  { label: "Return home", href: "/", icon: House, primary: true },
  { label: "About", href: "/about", icon: UserRound },
  { label: "Experience", href: "/experience", icon: Briefcase },
  { label: "Publications", href: "/publications", icon: BookOpen },
  { label: "Contact", href: "/contact", icon: Mail },
];
---

<BaseLayout title="Page not found" description={notFound.message} noindex>
  <section class="pt-32 pb-20 bg-background relative overflow-hidden min-h-screen flex items-center">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,var(--tw-gradient-stops))] from-secondary/50 via-background to-background -z-10"></div>
    <MandalaMotif spin style="top:50%;left:50%;width:640px;height:640px;opacity:0.06;transform:translate(-50%,-50%)" />
    <MandalaMotif style="bottom:-160px;right:-140px;width:380px;height:380px;opacity:0.045" />
    <PaisleyMotif class="text-primary" style="top:16%;left:4%;width:56px;height:90px;opacity:0.07;transform:rotate(-20deg)" />
    <PaisleyMotif class="text-accent" style="top:12%;left:9%;width:42px;height:68px;opacity:0.055;transform:scaleX(-1) rotate(-10deg)" />

    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span
          class="inline-block py-1 px-3 rounded-full bg-secondary text-primary text-sm font-medium mb-6"
          data-reveal="up"
        >
          Error 404 • Page not found
        </span>

        <p
          class="font-serif font-bold text-[7rem] md:text-[10rem] leading-none text-primary/90 select-none"
          aria-hidden="true"
          data-reveal="up"
          style="--delay:0.1s"
        >
          4<span class="text-accent">0</span>4
        </p>

        <!-- Vital-signs trace: flat, a single heartbeat, flat again -->
        <svg
          viewBox="0 0 600 80"
          class="w-full max-w-xl mx-auto h-16 md:h-20 -mt-2 mb-6"
          fill="none"
          aria-hidden="true"
          data-reveal="up"
          style="--delay:0.15s"
        >
          <path d="M0 40 H600" stroke="hsl(var(--border))" stroke-width="1" stroke-dasharray="4 6"></path>
          <path
            class="ecg-trace"
            d="M0 40 H220 L240 40 L252 18 L264 62 L280 6 L296 72 L310 40 L330 40 L342 30 L354 40 H600"
            stroke="hsl(var(--primary))"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>

        <h1
          class="text-4xl md:text-5xl font-serif font-semibold text-foreground mb-4"
          data-reveal="up"
          style="--delay:0.2s"
        >
          {notFound.heading}
        </h1>
        <div class="gold-divider mx-auto"></div>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed" data-reveal="up" style="--delay:0.25s">
          {notFound.message}
        </p>
      </div>

      <!-- Case-note card -->
      <div
        class="mt-12 max-w-2xl mx-auto bg-white/85 backdrop-blur-sm rounded-2xl border border-border shadow-sm overflow-hidden text-left"
        data-reveal="up-sm"
        style="--delay:0.3s"
      >
        <div class="flex items-center gap-3 px-6 py-4 border-b border-border bg-secondary/30">
          <span class="w-9 h-9 rounded-full bg-white flex items-center justify-center text-primary shadow-sm">
            <Stethoscope size={18} aria-hidden="true" />
          </span>
          <h2 class="font-serif text-xl font-semibold text-foreground">Visit summary</h2>
        </div>
        <dl class="divide-y divide-border text-sm">
          <div class="grid grid-cols-1 sm:grid-cols-[11rem_1fr] gap-1 sm:gap-4 px-6 py-3">
            <dt class="font-medium text-muted-foreground">Requested address</dt>
            <dd class="text-foreground font-mono text-[0.8rem] break-all" id="requested-path">—</dd>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-[11rem_1fr] gap-1 sm:gap-4 px-6 py-3">
            <dt class="font-medium text-muted-foreground">Finding</dt>
            <dd class="text-foreground">No page exists at this address.</dd>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-[11rem_1fr] gap-1 sm:gap-4 px-6 py-3">
            <dt class="font-medium text-muted-foreground">Likely cause</dt>
            <dd class="text-foreground">An outdated bookmark, a mistyped address, or a page that has moved.</dd>
          </div>
          <div class="px-6 py-4">
            <dt class="font-medium text-muted-foreground mb-3">Recommended next steps</dt>
            <dd>
              <ul class="flex flex-wrap gap-2" role="list">
                {
                  nextSteps.map((step) => (
                    <li>
                      <a
                        href={step.href}
                        class:list={[
                          "inline-flex items-center gap-2 h-9 px-4 rounded-full text-sm font-medium transition-colors",
                          step.primary
                            ? "bg-primary text-white hover:bg-primary/90"
                            : "border border-border text-foreground hover:border-primary hover:text-primary bg-background",
                        ]}
                      >
                        <step.icon size={16} aria-hidden="true" />
                        {step.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
  <JaliBorder id="notfound-bottom" class="text-primary/25" />
</BaseLayout>

<script>
  const el = document.getElementById("requested-path");
  if (el) el.textContent = decodeURIComponent(window.location.pathname + window.location.search);
</script>
